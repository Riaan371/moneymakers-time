{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoneyMakers Tracker",
  "version": "0.1.0",
  "identifier": "co.za.moneymakers.tracker",
  "build": {
    "frontendDist": "login.html"
  },
  "app": {
    "windows": [
      {
        "label": "login",
        "title": "MoneyMakers Tracker — Sign in",
        "url": "login.html",
        "width": 380,
        "height": 340,
        "resizable": false,
        "visible": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "MoneyMakers Tracker"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
